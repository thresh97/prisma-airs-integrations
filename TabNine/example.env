# Prisma AIRS Configuration for Tabnine CLI Security Hooks
# Copy this file to .env and configure your settings

# ============================================
# REQUIRED: Prisma AIRS API Configuration
# ============================================

# Your Prisma AIRS API token
# Get this from: https://www.paloaltonetworks.com/prisma/ai-runtime-security
PRISMA_AIRS_API_KEY="your-prisma-airs-api-key-here"

# ============================================
# OPTIONAL: API Endpoint
# ============================================

# Prisma AIRS API base URL (defaults to US endpoint when unset)
# PRISMA_AIRS_API_URL="https://service.api.aisecurity.paloaltonetworks.com/v1/scan/sync/request"

# ============================================
# OPTIONAL: Security Profile Configuration
# ============================================

# Security profile name (configure in Prisma AIRS dashboard)
PRISMA_AIRS_PROFILE_NAME="your-security-profile-name"

# Security profile ID (takes precedence over profile name if both are set)
# PRISMA_AIRS_PROFILE_ID="your-profile-uuid"

# ============================================
# USAGE INSTRUCTIONS
# ============================================

# 1. Copy this file to .env:
#    cp example.env .env

# 2. Edit .env and fill in PRISMA_AIRS_API_KEY and PRISMA_AIRS_PROFILE_NAME

# 3. Copy settings.json.example to the Tabnine config location:
#    Project-level:  cp settings.json.example .tabnine/agent/settings.json
#    User-level:     cp settings.json.example ~/.tabnine/agent/settings.json

# 4. Make hook scripts executable:
#    chmod +x .tabnine/hooks/*.sh

# 5. Source environment variables before running Tabnine CLI:
#    source .env
#    Or add to your shell profile (~/.zshrc or ~/.bashrc):
#    export PRISMA_AIRS_API_KEY="your-key-here"
#    export PRISMA_AIRS_PROFILE_NAME="your-profile-name"

# Security scan logs are written to .tabnine/hooks/prisma-airs.log

# ============================================
# SECURITY NOTES
# ============================================

# - NEVER commit .env to version control — add it to .gitignore
# - Rotate API keys every 90 days
# - Use restrictive profiles in production
# - Monitor prisma-airs.log for false positives
# - Tabnine CLI warns if a hook command changes unexpectedly (supply chain protection)
